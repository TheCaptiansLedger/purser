# Build output
/purser
*.exe

# goreleaser output (binaries, archives, container build context) — see
# docs/adr/0017-build-and-release-goreleaser.md
/dist/

# Locally-installed pinned dev tooling (buf, protoc-gen-*, goreleaser) — see Makefile `tools` target
/.gobin/

# Web build artifacts and dependencies
web/dist/
web/node_modules/

# All local dev-state: datastore files, downloaded media, and the compose
# stack's Postgres/Grafana/Prometheus/Tempo data — see
# docs/adr/0018-local-development-environment.md. test-data/ (below) is a
# deliberate exception, not part of this tree.
/.local/

# Standalone-app data dir for `make k6-ci` (Badger-backed purser binary,
# k6 assertion suite) — deliberately separate from /.local/ and wiped at
# the start of every run, so it never inherits box-specific state. See
# docs/adr/0022-k6-ci-enforcement.md.
/.cidata/

# Env with real secrets
.env
.envrc

# SQLite database files
*.db
*.db-shm
*.db-wal

# Config with local secrets — anchored to repo root only. Unanchored, this
# also matched (and had silently, permanently untracked) ops/purser.yaml,
# the compose stack's checked-in example config.
/purser.yaml

# OS
.DS_Store

# IDE
.idea/
.vscode/


# Test media files for scan pipeline development
test-data/*
!test-data/.gitkeep

.claude

# go test -coverprofile output — regenerated by every `make test-ci` /
# pre-commit run, never meant to be committed. Codecov gets its copy from
# the CI upload step, not from git history.
/coverage.out
