# Copy this file to .env and fill in your keys.
# This file documents both the seeder (cmd/seed) and the app (PURSER_ prefix) variables.

# ═══════════════════════════════════════════════════════════════════════════════
# APP CONFIGURATION (PURSER_ prefix, read by the Purser server)
# ═══════════════════════════════════════════════════════════════════════════════

# ── StashDB (adult + JAV) ────────────────────────────────────────────────────
# Log in at https://stashdb.org → Settings → API Key
# PURSER_SOURCES_STASHDB_ENABLED=true
# PURSER_SOURCES_STASHDB_API_KEY=

# ── TPDB (adult + JAV) ───────────────────────────────────────────────────────
# Get a key at https://theporndb.net
# PURSER_SOURCES_TPDB_ENABLED=true
# PURSER_SOURCES_TPDB_API_KEY=

# ── Stash (self-hosted, adult + JAV) ─────────────────────────────────────────
# URL is required; API key is optional if auth is disabled on your instance.
# PURSER_SOURCES_STASH_ENABLED=true
# PURSER_SOURCES_STASH_URL=http://stash.local:9999
# PURSER_SOURCES_STASH_API_KEY=

# ── TMDB (movies + TV) ───────────────────────────────────────────────────────
# Get the v4 "API Read Access Token" at https://www.themoviedb.org/settings/api
# Use the long bearer token, not the short API key.
# PURSER_SOURCES_TMDB_ENABLED=true
# PURSER_SOURCES_TMDB_API_KEY=

# ── TVDB (TV shows) ──────────────────────────────────────────────────────────
# Create an API key at https://thetvdb.com/dashboard/account/apikeys
# PURSER_SOURCES_TVDB_ENABLED=true
# PURSER_SOURCES_TVDB_API_KEY=

# ── MusicBrainz (music) ──────────────────────────────────────────────────────
# No API key required. Set a descriptive User-Agent per MusicBrainz policy.
# PURSER_SOURCES_MUSICBRAINZ_ENABLED=true
# PURSER_SOURCES_MUSICBRAINZ_USER_AGENT=purser/1.0 (you@example.com)

# ── TheAudioDB (music) ───────────────────────────────────────────────────────
# Free tier uses API key "123". Sign up at https://www.theaudiodb.com for a
# Patreon key if you need the v2 API (higher rate limits, more fields).
# PURSER_SOURCES_THEAUDIODB_ENABLED=true
# PURSER_SOURCES_THEAUDIODB_API_KEY=123

# ── fanart.tv (music) ────────────────────────────────────────────────────────
# Get a personal API key at https://fanart.tv/get-an-api-key/
# PURSER_SOURCES_FANART_ENABLED=true
# PURSER_SOURCES_FANART_API_KEY=

# ── Last.fm (music) ──────────────────────────────────────────────────────────
# Create an API key at https://www.last.fm/api/account/create
# PURSER_SOURCES_LASTFM_ENABLED=true
# PURSER_SOURCES_LASTFM_API_KEY=

# ── OpenLibrary (books) ───────────────────────────────────────────────────────
# No API key required.
# PURSER_SOURCES_OPENLIBRARY_ENABLED=true

# ── Prowlarr (indexer search) ─────────────────────────────────────────────────
# Self-hosted only — no public default instance, so base_url is required.
# Point it at Prowlarr's API root, api key from Prowlarr → Settings → General.
# Flat PURSER_PROWLARR_* key, not under PURSER_SOURCES_* — see
# internal/config/prowlarr.go's doc comment for why.
# PURSER_PROWLARR_ENABLED=true
# PURSER_PROWLARR_BASE_URL=http://prowlarr.local:9696/api/v1
# PURSER_PROWLARR_API_KEY=
# A real search fans out to every enabled indexer; raise this if your
# deployment sees it timing out against the adapter's own 25s default.
# PURSER_PROWLARR_RESPONSE_HEADER_TIMEOUT=45s

# ── Data directory ────────────────────────────────────────────────────────────
# Base directory Purser's own data lives under (Badger's data dir and the
# SQLite DSN both default under it — see PURSER_DATABASE_* below). Defaults to
# the OS-appropriate per-user app data directory (e.g. ~/.config/purser on
# Linux) when unset.
#
# Uncomment these two to point `make run` (native) at the exact same files
# ops/compose.yml bind-mounts into the container — switch between running
# natively and containerized without losing or re-seeding data. See
# docs/adr/0018-local-development-environment.md.
# PURSER_PATHS_DATA_DIR=.local/data
# PURSER_MEDIA_PATH=.local/media

# ── Database driver ───────────────────────────────────────────────────────────
# Default driver is badger. Set PURSER_DATABASE_DRIVER to switch backends.
# All four drivers persist through the same generic Datastore abstraction —
# see docs/adr/0012-datastore-persistence.md.
#
# BadgerDB (default) — pure-Go embedded LSM-tree store, no CGo, distroless-safe
# PURSER_DATABASE_DRIVER=badger
# PURSER_DATABASE_BADGER_DATA_DIR=./purser-data        # directory for LSM + vlog files (default: <data_dir>/badger)
# PURSER_DATABASE_BADGER_VALUE_LOG_DIR=                # separate vlog disk (optional, high-throughput)
# PURSER_DATABASE_BADGER_SYNC_WRITES=false             # flush every write to disk (default: false)
#
# SQLite — single-file relational store, pure-Go driver (modernc.org/sqlite), no CGo
# PURSER_DATABASE_DRIVER=sqlite
# PURSER_DATABASE_SQL_DSN=purser.db                    # path to the .db file (default: <data_dir>/purser.db)
#
# PostgreSQL
# PURSER_DATABASE_DRIVER=postgres
# PURSER_DATABASE_SQL_DSN=postgres://user:pass@localhost:5432/purser
#
# MySQL
# PURSER_DATABASE_DRIVER=mysql
# PURSER_DATABASE_SQL_DSN=user:pass@tcp(localhost:3306)/purser

# ── Optional path/port overrides ─────────────────────────────────────────────
# PURSER_MODULES_MOVIES_ROOTS=/mnt/disk1/movies,/mnt/disk2/movies
# PURSER_MODULES_TV_ROOTS=/nas/tv

# ── Telemetry (OTLP traces + Prometheus metrics) ─────────────────────────────
# Off by default so `go run`/`go test` never blocks on a missing collector.
# `ops/purser.yaml` (the containerized app's config) already enables this
# against the compose stack's own Tempo/Prometheus — see
# docs/adr/0007-telemetry.md and docs/adr/0018-local-development-environment.md.
# Set these to point a natively-run binary at the same compose-stack Tempo
# (published on localhost:4317) instead.
# PURSER_TELEMETRY_ENABLED=true
# PURSER_TELEMETRY_OTLP_ENDPOINT=localhost:4317
# PURSER_TELEMETRY_OTLP_INSECURE=true
# PURSER_TELEMETRY_METRICS_ADDR=:9464

# ── Common scan pipeline (hashing) ───────────────────────────────────────────
# OSHash and SHA1 are always computed for every discovered file. MD5/SHA512
# are optional extra full-file hashes, off by default — see
# docs/adr/0024-pipeline-core.md.
# PURSER_PIPELINE_ENABLE_MD5=true
# PURSER_PIPELINE_ENABLE_SHA512=true
# scan_roots (directories to watch live, each paired with the content type
# it holds) is a list of {path, content_type} pairs, not expressible as a
# single flat env var — set it in ops/purser.yaml only. Unset/empty starts
# no watcher at all.

# ═══════════════════════════════════════════════════════════════════════════════
# LOCAL OBSERVABILITY STACK (ops/compose.yml — Postgres/Grafana/Prometheus/Tempo)
# ═══════════════════════════════════════════════════════════════════════════════
# `make compose up` refuses to start Postgres/Grafana without these — they
# have no defaults on purpose, so no weak password ships anywhere. One
# Postgres instance hosts two isolated roles/databases (app + Grafana's own
# backend) — see docs/adr/0018-local-development-environment.md and
# ops/postgres/init-multi-db.sh.

# Postgres superuser, used only to bootstrap the two roles below.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=

# App's own role/database (also usable as PURSER_DATABASE_SQL_DSN's
# credentials if you set PURSER_DATABASE_DRIVER=postgres).
PURSER_DB_USER=purser
PURSER_DB_PASSWORD=
PURSER_DB_NAME=purser

# Grafana's role/database — backs its own dashboards/users/datasource
# config instead of Grafana's default embedded SQLite.
GRAFANA_DB_USER=grafana
GRAFANA_DB_PASSWORD=
GRAFANA_DB_NAME=grafana

# Grafana's own admin login (http://localhost:3000, user "admin").
GRAFANA_ADMIN_PASSWORD=

# ═══════════════════════════════════════════════════════════════════════════════
# SEEDER CONFIGURATION (cmd/seed, read by the seed tool only)
# ═══════════════════════════════════════════════════════════════════════════════

# ── TMDB (movies + TV shows) ─────────────────────────────────────────────────
TMDB_API_KEY=

# ── StashDB (adult + JAV) ────────────────────────────────────────────────────
STASHDB_API_KEY=

# ── MusicBrainz ──────────────────────────────────────────────────────────────
# No key required. MusicBrainz asks for a descriptive User-Agent instead.
MUSICBRAINZ_APP=purser-seed/0.1
