# syntax=docker/dockerfile:1
#
# Copy-only runtime image — see docs/adr/0017-build-and-release-goreleaser.md.
# Goreleaser is the only thing that builds the `purser` binary; this
# Dockerfile never runs `go build`. It expects, at the build context root:
#   ./purser     — the prebuilt binary for the target platform
#   ./web/dist   — the prebuilt React UI
#
# Goreleaser's `dockers` config stages both automatically per platform.
# For a local single-arch image outside goreleaser's release pipeline, use
# `make compose build` — it runs `goreleaser build --single-target
# --snapshot` first and stages the binary at the repo root before calling
# `docker build`, so this Dockerfile never needs a separate "dev" variant.
FROM debian:13-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates \
      tzdata \
      ffmpeg \
      libchromaprint-tools \
    && rm -rf /var/lib/apt/lists/*

COPY purser /usr/local/bin/purser
COPY web/dist /web/dist

VOLUME ["/data", "/media/purser", "/media/content"]

EXPOSE 7474

ENTRYPOINT ["/usr/local/bin/purser"]
CMD ["serve", "--config", "/config/purser.yaml"]
