# syntax=docker/dockerfile:1
#
# Copy-only runtime image — see docs/adr/0017-build-and-release-goreleaser.md.
# Goreleaser is the only thing that builds the `purser` binary; this
# Dockerfile never runs `go build`. It expects, at the build context root:
#   ./purser   — the prebuilt binary for the target platform
#
# The React UI is NOT copied in separately — cmd/purser serve embeds
# web/dist into the binary itself at build time (web/embed.go), so
# `./purser` already carries the UI. web/dist has to exist and be built
# *before* `goreleaser build` runs (goreleaser never invokes `npm run
# build`), which `make build image`/`make dev` already sequence
# correctly — see docs/design/frontend-stack.md.
#
# Goreleaser's `dockers` config stages the binary automatically per
# platform. For a local single-arch image outside goreleaser's release
# pipeline, use `make dev` (or `make build image` directly) — it runs
# `goreleaser build --single-target --snapshot` first and stages the
# binary at the repo root before calling `docker build`, so this
# Dockerfile never needs a separate "dev" variant.
FROM debian:12-slim

# ffmpeg provides ffprobe (Music's FileFingerprinter, M4); libchromaprint-tools
# provides fpcalc (AcoustID, M5) — the pipeline's media toolchain. See
# docs/technical/pipeline-music-fingerprinter.md and
# docs/technical/pipeline-music-acoustid-adapter.md.
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates \
      tzdata \
      ffmpeg \
      libchromaprint-tools \
    && rm -rf /var/lib/apt/lists/*

COPY purser /usr/local/bin/purser

VOLUME ["/data", "/media/purser", "/media/content"]

EXPOSE 7474

ENTRYPOINT ["/usr/local/bin/purser"]
CMD ["serve", "--config", "/config/purser.yaml"]
